<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel"
    modelDirectory="/recipebook/src-gen" creationIcons="false" editDirectory="/recipebook.edit/src-gen"
    editorDirectory="/recipebook.editor/src-gen" modelPluginID="recipebook" modelName="Recipebook"
    rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container" codeFormatting="true"
    importerID="org.eclipse.emf.importer.ecore" complianceLevel="25.0" copyrightFields="false"
    operationReflection="true" importOrganizing="true">
  <foreignModel>recipebook.ecore</foreignModel>
  <testsDirectory xsi:nil="true"/>
  <genPackages prefix="Recipebook" disposableProviderFactory="true" ecorePackage="recipebook.ecore#/">
    <genClasses ecoreClass="recipebook.ecore#//Recipe">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/name"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/servings"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/timeToCook"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/instructions"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference recipebook.ecore#//Recipe/ingredients"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/carbs"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/protein"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/fats"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Recipe/kcal"/>
    </genClasses>
    <genClasses ecoreClass="recipebook.ecore#//Ingredient">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Ingredient/name"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//Ingredient/category"/>
    </genClasses>
    <genClasses ecoreClass="recipebook.ecore#//RecipeIngredient">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//RecipeIngredient/quantity"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute recipebook.ecore#//RecipeIngredient/unit"/>
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference recipebook.ecore#//RecipeIngredient/ingredient"/>
    </genClasses>
    <genClasses ecoreClass="recipebook.ecore#//RecipeBook">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference recipebook.ecore#//RecipeBook/recipes"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference recipebook.ecore#//RecipeBook/ingredients"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>
