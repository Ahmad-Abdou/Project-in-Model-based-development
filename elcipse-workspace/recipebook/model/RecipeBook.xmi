  </recipes>
   <recipes name="V_Byriani" servings="3" timeToCook="30" instructions="Sauté sliced onions and peppers in oil until soft, then mix in spices and cooked basmati rice. Cover and steam on low heat for a few minutes until warm and well combined" carbs="150.0" protein="30.0" fats="45.0" kcal="650.0">
