  <recipes name="PastaWithMeatballs" servings="2" timeToCook="10" instructions="Mix seasoned ground meat into small balls and simmer them in a tomato sauce while boiling pasta. Toss the cooked pasta directly into the meatball sauce and serve hot" carbs="50.0" protein="25.0" fats="30.0" kcal="500.0">
